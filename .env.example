# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://utente:password@localhost:5432/phantomlab?schema=public"

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Token del bot ottenuto da @BotFather.
TELEGRAM_BOT_TOKEN=""

# Username del bot senza @ (serve per il deep link di accesso da browser).
TELEGRAM_BOT_USERNAME=""

# Chat ID che riceve le notifiche delle nuove richieste.
TELEGRAM_ADMIN_CHAT_ID=""

# Segreto per validare le chiamate al webhook (stringa casuale).
TELEGRAM_WEBHOOK_SECRET=""

# Telegram ID separati da virgola che ricevono il ruolo ADMIN.
ADMIN_TELEGRAM_IDS=""

# ---------------------------------------------------------------------------
# Sicurezza
# ---------------------------------------------------------------------------
# Segreto per firmare sessioni e cookie di accesso. Generare con:
#   openssl rand -base64 48
AUTH_SECRET=""

# In sviluppo consente l'accesso senza Telegram. In produzione deve restare "false".
ALLOW_DEV_LOGIN="false"

# ---------------------------------------------------------------------------
# Modalità cantiere
# ---------------------------------------------------------------------------
# "true" mostra a tutti la pagina di attesa; si entra con la password
# facendo doppio clic sul logo.
SITO_CHIUSO="true"
SITO_PASSWORD=""

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV="production"
PORT="3000"
