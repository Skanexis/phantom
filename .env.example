# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://utente:password@localhost:5432/phantomlab?schema=public"

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Token del bot ottenuto da @BotFather.
TELEGRAM_BOT_TOKEN=""

# Username del bot senza @ (serve per il deep link di accesso da browser).
TELEGRAM_BOT_USERNAME=""

# Chat ID che riceve le notifiche delle nuove richieste.
TELEGRAM_ADMIN_CHAT_ID=""

# Segreto per validare le chiamate al webhook (stringa casuale).
TELEGRAM_WEBHOOK_SECRET=""

# Telegram ID separati da virgola che ricevono il ruolo ADMIN.
ADMIN_TELEGRAM_IDS=""

# ---------------------------------------------------------------------------
# Sicurezza
# ---------------------------------------------------------------------------
# Segreto per firmare sessioni e cookie di accesso. Generare con:
#   openssl rand -base64 48
AUTH_SECRET=""

# In sviluppo consente l'accesso senza Telegram. In produzione deve restare "false".
ALLOW_DEV_LOGIN="false"

# Segmento della rotta della scheda DEV.LOGS, che mostra l'attività dello
# staff. Generare con:
#   openssl rand -hex 16
#
# Non è un segreto di sicurezza e non va confuso con AUTH_SECRET: a proteggere
# quella scheda è il ruolo DEVELOPER, e senza sessione valida non si entra
# comunque. Serve solo a tenere l'indirizzo fuori dai dizionari degli scanner,
# così la rotta non compare nemmeno fra i tentativi respinti.
#
# Se è vuoto o più corto di 16 caratteri la scheda non compare e la rotta
# risponde 404: senza valore si sta chiusi, non aperti.
SEGMENTO_DEV_LOGS=""

# Chiave per leggere le decisioni di CrowdSec e mostrarle nel pannello.
# La stampa `sudo bash deploy/crowdsec.sh <IL_TUO_IP>` durante l'installazione.
#
# Facoltativa: senza, il sito funziona identico e la sezione CrowdSec del
# pannello resta nascosta. CrowdSec blocca comunque — semplicemente i suoi
# provvedimenti restano visibili solo da `cscli decisions list`, perché il
# pacchetto muore nel firewall e non lascia traccia nei log.
CROWDSEC_API_KEY=""

# ---------------------------------------------------------------------------
# Modalità cantiere
# ---------------------------------------------------------------------------
# "true" mostra a tutti la pagina di attesa; si entra con la password
# facendo doppio clic sul logo.
SITO_CHIUSO="true"
SITO_PASSWORD=""

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV="production"
PORT="3000"
