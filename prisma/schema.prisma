// Schema dati Phantom Lab.
// In produzione sostituire provider con "postgresql" e aggiornare DATABASE_URL.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Ruolo {
  UTENTE
  SUPPORTO
  ADMIN
  DEVELOPER
}

enum StatoRichiesta {
  NUOVA
  IN_LAVORAZIONE
  IN_ATTESA_CLIENTE
  COMPLETATA
  ANNULLATA
}

enum AmbitoSviluppo {
  SITO_WEB
  APPLICAZIONE
  /// Non più scelta dal modulo generico: si arriva qui solo dalle carte
  /// della sezione "Automatizzati con noi", che impostano l'ambito da sole.
  AUTOMAZIONE
  /// Non uno sviluppo su misura: assistenza per chi ha già un abbonamento
  /// attivo. Il dettaglio del tipo sta in TipoSupporto.
  SUPPORTO
  /// Cambio valuta cripto/contanti/bonifico. Il dettaglio sta in
  /// DirezioneScambio, Criptovaluta e importoCentesimi.
  EXCHANGE
}

/// Classificazione di una richiesta di supporto, riservata a chi ha un
/// abbonamento attivo. Guida colore e icona in tutta l'interfaccia.
enum TipoSupporto {
  PROBLEMA
  DOMANDA
  MIGLIORAMENTO
}

/// Verso di conversione per una richiesta di ambito EXCHANGE.
enum DirezioneScambio {
  CRIPTO_CONTANTI
  CONTANTI_CRIPTO
  CRIPTO_BONIFICO
  BONIFICO_CRIPTO
}

/// Criptovalute accettate per lo scambio. Solo due per ora: ogni aggiunta
/// va verificata con chi gestisce la liquidità prima di aprirla in UI.
enum Criptovaluta {
  BTC
  USDC
}

enum StatoAbbonamentoUtente {
  IN_ATTESA
  ATTIVO
  SOSPESO
  SCADUTO
  ANNULLATO
}

model Utente {
  id             String   @id @default(cuid())
  telegramId     String   @unique
  username       String?
  nome           String?
  cognome        String?
  linguaTelegram String?
  urlFoto        String?
  ruolo          Ruolo    @default(UTENTE)
  creatoIl       DateTime @default(now())
  aggiornatoIl   DateTime @updatedAt

  /// Blocco dell'account, deciso da ADMIN o DEVELOPER. Separato dal ruolo:
  /// un account bloccato conserva il suo ruolo e lo ritrova allo sblocco,
  /// mentre degradarlo a UTENTE perderebbe l'informazione per sempre.
  bloccato     Boolean   @default(false)
  bloccatoIl   DateTime?
  motivoBlocco String?
  /// Chi ha deciso il blocco. Nessuna relazione: se quell'account viene
  /// cancellato la traccia deve restare comunque leggibile.
  bloccatoDaId String?

  richieste            Richiesta[]
  abbonamentiUtente    AbbonamentoUtente[]
  notifiche            Notifica[]
  tokenCollegamento    TokenCollegamento[]
  segnalazioniRicevute Segnalazione[]      @relation("SegnalazioniRicevute")
  segnalazioniFatte    Segnalazione[]      @relation("SegnalazioniFatte")

  @@index([ruolo])
  @@index([bloccato])
}

enum StatoSegnalazione {
  APERTA
  PRESA_IN_CARICO
  CHIUSA
}

/// Segnalazione di un account da parte dello staff.
///
/// Esiste perché SUPPORTO vede i clienti tutto il giorno ma non ha — e non
/// deve avere — il potere di bloccarli: senza un canale formale l'unica
/// strada sarebbe un messaggio privato a un admin, che non lascia traccia e
/// si perde. Qui la richiesta è una riga con un autore, uno stato e una
/// data, e l'admin la trova nel pannello invece che in una chat.
model Segnalazione {
  id       String            @id @default(cuid())
  utenteId String
  autoreId String
  motivo   String
  stato    StatoSegnalazione @default(APERTA)
  /// Nota di chi l'ha chiusa: perché sì o perché no.
  esito    String?
  creatoIl DateTime          @default(now())
  chiusoIl DateTime?

  utente Utente @relation("SegnalazioniRicevute", fields: [utenteId], references: [id], onDelete: Cascade)
  autore Utente @relation("SegnalazioniFatte", fields: [autoreId], references: [id], onDelete: Cascade)

  @@index([stato, creatoIl])
  @@index([utenteId])
}

enum TipoBando {
  IP
  /// Intervallo di indirizzi in forma CIDR, già normalizzato al prefisso con
  /// cui è stato deciso: la verifica nel perimetro è una lettura da un
  /// insieme, non un confronto con ogni provvedimento in elenco. I prefissi
  /// ammessi sono un elenco chiuso (vedi PREFISSI_SOTTORETE in lib/rete.ts).
  SOTTORETE
  DISPOSITIVO
}

/// Esclusione a livello di rete, riservata a DEVELOPER.
///
/// Il blocco dell'account ferma una persona che ha un account; questo ferma
/// chi non ce l'ha, o chi se ne crea un altro. Sono due strumenti diversi e
/// vanno tenuti separati: il primo è una decisione sul cliente, il secondo
/// una decisione sul perimetro.
///
/// Sul tipo DISPOSITIVO vale una precisazione onesta, scritta qui perché è
/// il posto in cui verrà letta: non è un'impronta dell'hardware. Un sito web
/// non può vedere il numero di serie di una macchina. È un identificativo
/// casuale che il server deposita nel browser e ritrova alle visite
/// successive: regge il cambio di rete e di indirizzo IP, non regge la
/// navigazione in incognito né la cancellazione dei dati del sito.
model Bando {
  id       String    @id @default(cuid())
  tipo     TipoBando
  valore   String
  /// Attenzione: questo testo lo legge anche chi è stato bloccato, sulla
  /// schermata /bloccato. Non è più una nota interna fra chi decide — deve
  /// spiegare il provvedimento a chi lo subisce, senza raccontare come è
  /// stato scoperto un abuso.
  motivo   String
  creatoIl DateTime  @default(now())
  /// Null significa permanente.
  scadeIl  DateTime?
  autoreId String?

  @@unique([tipo, valore])
  @@index([tipo])
}

/// Indirizzo esentato dal bando della propria sottorete.
///
/// Nasce quasi sempre da un ricorso accolto: un attacco parte da una rete,
/// la rete viene bandita, e dietro quegli stessi indirizzi c'era anche
/// qualcuno che non c'entrava nulla. Revocare il bando riaprirebbe la porta
/// all'attacco; questa riga corregge il singolo caso lasciando in piedi il
/// provvedimento.
model EccezioneRete {
  id        String    @id @default(cuid())
  ip        String    @unique
  motivo    String
  creatoIl  DateTime  @default(now())
  /// Null significa permanente.
  scadeIl   DateTime?
  autoreId  String?
  /// Il ricorso da cui è nata, quando c'è.
  ricorsoId String?
}

enum StatoRicorso {
  APERTO
  ACCOLTO
  RESPINTO
}

/// Richiesta di riesame inviata da chi è stato bloccato.
///
/// È l'unica cosa che una persona bloccata può fare sul sito, ed è
/// deliberato: il bando di rete colpisce per intervallo, quindi produce
/// falsi positivi per costruzione, e senza un canale di ritorno l'unico
/// modo di accorgersene sarebbe che qualcuno riesca a scrivere altrove.
///
/// I dati tecnici (indirizzo, sottorete, marcatore, agente) si registrano
/// al momento dell'invio e non si chiedono a chi scrive: sono già noti al
/// server, e farli digitare produrrebbe solo errori.
model Ricorso {
  id          String       @id @default(cuid())
  /// Cosa lo aveva bloccato: ip, sottorete, dispositivo, account.
  causa       String
  /// Il valore che aveva fatto scattare il blocco.
  valore      String
  ip          String
  sottorete   String?
  dispositivo String?
  utenteId    String?
  messaggio   String
  /// Come farsi ricontattare, se lo indica. Facoltativo di proposito.
  contatto    String?
  agente      String
  stato       StatoRicorso @default(APERTO)
  creatoIl    DateTime     @default(now())
  decisoIl    DateTime?
  decisoDaId  String?
  /// Nota di chi ha deciso. Interna, non mostrata a chi ha scritto.
  nota        String?

  @@index([stato, creatoIl])
  @@index([ip])
}

/// Storico delle decisioni prese da CrowdSec.
///
/// CrowdSec le conserva finché sono in vigore: scadute, spariscono. Ma la
/// domanda utile arriva quasi sempre dopo — «questo indirizzo era già stato
/// bloccato?», «da quanto tempo insistono da questa rete?» — e senza una
/// copia nostra la risposta non esiste da nessuna parte, perché il traffico
/// bloccato non lascia traccia nemmeno nei log di Nginx.
///
/// Si scrive quando il compito periodico vede una decisione per la prima
/// volta: `vistoIl` è quando ce ne siamo accorti, non quando CrowdSec l'ha
/// presa. La differenza è al massimo di venti secondi e non vale una
/// chiamata in più per scoprirla.
model DecisioneCrowdSec {
  id        Int      @id @default(autoincrement())
  /// Indirizzo o rete colpita, come la scrive CrowdSec.
  valore    String
  tipo      String
  scenario  String
  /// "crowdsec" per le decisioni locali, "CAPI"/"lists" per l'elenco
  /// condiviso: distinguerle è tutto, perché solo le prime riguardano noi.
  origine   String
  durata    String
  vistoIl   DateTime @default(now())
  /// Quando è sparita dall'elenco delle decisioni in vigore.
  scadutaIl DateTime?

  @@unique([valore, scenario])
  @@index([vistoIl])
  @@index([origine, vistoIl])
}

/// Archivio duraturo delle richieste, per la scheda Logs.
///
/// La sorveglianza dal vivo resta in memoria e si azzera a ogni riavvio: è
/// una finestra sul presente, e va bene così. Questa tabella risponde
/// all'altra domanda, quella che la memoria non può reggere — cosa faceva
/// quell'indirizzo tre settimane fa.
///
/// Non si scrive dentro una richiesta. Le righe passano da una coda in
/// memoria che un compito periodico svuota a lotti (vedi lib/registro-db.ts):
/// un INSERT per richiesta trasformerebbe il traffico ostile in carico sul
/// database, cioè renderebbe l'archivio complice del problema che deve
/// documentare.
///
/// Nessuna chiave esterna verso Utente: il registro deve sopravvivere alla
/// cancellazione di un account, e un vincolo costerebbe una verifica a ogni
/// riga inserita.
model RegistroRichiesta {
  /// Int e non BigInt: due miliardi di righe sono ordini di grandezza oltre
  /// l'orizzonte di questo sito, e BigInt esplode in JSON.stringify — cioè
  /// esattamente dove finisce, nella risposta della rotta del pannello.
  id          Int      @id @default(autoincrement())
  quando      DateTime @default(now())
  livello     String
  metodo      String
  percorso    String
  ip          String
  /// Precalcolata alla scrittura: filtrare per rete è una domanda frequente,
  /// e ricavarla in SQL su milioni di righe impedirebbe di usare un indice.
  sottorete   String?
  paese       String?
  utenteId    String?
  telegramId  String?
  ruolo       String?
  dispositivo String?
  agente      String
  esito       String
  stato       Int?
  tipo        String?
  /// Unite in una stringa: è testo da mostrare, non dati da interrogare.
  motivi      String?
  durataMs    Int      @default(0)

  @@index([quando])
  @@index([ip, quando])
  @@index([livello, quando])
  @@index([utenteId, quando])
  @@index([sottorete, quando])
  @@index([percorso, quando])
  /// Alimenta la scheda DEV.LOGS, che isola l'attività di chi ha un ruolo.
  /// Senza, il filtro per ruolo su un archivio annuale è una scansione: le
  /// righe dello staff sono una frazione minima del totale, quindi
  /// esattamente il caso in cui un indice cambia tutto.
  @@index([ruolo, quando])
}

/// Piani di abbonamento, interamente editabili dal pannello admin.
model Abbonamento {
  id             String   @id @default(cuid())
  slug           String   @unique
  nome           String
  sottotitolo    String?
  descrizione    String
  prezzoCentesimi Int
  valuta         String   @default("EUR")
  periodo        String   @default("mese")
  attivo         Boolean  @default(true)
  inEvidenza     Boolean  @default(false)
  ordine         Int      @default(0)
  creatoIl       DateTime @default(now())
  aggiornatoIl   DateTime @updatedAt

  funzionalita       FunzionalitaAbbonamento[]
  abbonamentiUtente  AbbonamentoUtente[]

  @@index([attivo, ordine])
}

/// Singola voce dell'elenco funzionalità di un piano.
model FunzionalitaAbbonamento {
  id            String   @id @default(cuid())
  abbonamentoId String
  testo         String
  inclusa       Boolean  @default(true)
  ordine        Int      @default(0)

  abbonamento Abbonamento @relation(fields: [abbonamentoId], references: [id], onDelete: Cascade)

  @@index([abbonamentoId, ordine])
}

model AbbonamentoUtente {
  id            String                 @id @default(cuid())
  /// Codice breve tipo S-7B1C, come per le richieste.
  codice        String?                @unique
  utenteId      String
  abbonamentoId String
  stato         StatoAbbonamentoUtente @default(ATTIVO)
  inizioIl      DateTime               @default(now())
  scadeIl       DateTime?
  note          String?
  creatoIl      DateTime               @default(now())
  aggiornatoIl  DateTime               @updatedAt

  utente      Utente      @relation(fields: [utenteId], references: [id], onDelete: Cascade)
  abbonamento Abbonamento @relation(fields: [abbonamentoId], references: [id])

  @@index([utenteId, stato])
}

/// Richiesta di sviluppo su misura inviata dal form pubblico.
model Richiesta {
  id           String         @id @default(cuid())
  /// Numero progressivo leggibile, usato nelle comunicazioni col cliente.
  numero       Int            @unique @default(autoincrement())
  /// Codice breve tipo R-4F2A: si detta al telefono e si cerca a colpo d'occhio.
  codice       String?        @unique
  utenteId     String?
  ambito       AmbitoSviluppo
  /// Solo per ambito SUPPORTO: quale dei tre tipi, per colore/icona in UI.
  tipoSupporto TipoSupporto?
  /// I tre campi seguenti valgono solo per ambito EXCHANGE.
  direzioneScambio DirezioneScambio?
  criptovaluta     Criptovaluta?
  /// Controvalore in euro della transazione, in centesimi come altrove.
  importoCentesimi Int?
  /// I due campi seguenti valgono solo per ambito AUTOMAZIONE: copiati al
  /// momento dell'invio, non una relazione, così una richiesta già inviata
  /// mantiene il titolo scelto anche se l'automazione viene poi rinominata
  /// o rimossa dal pannello.
  automazioneSlug   String?
  automazioneTitolo String?
  stato        StatoRichiesta @default(NUOVA)
  nomeContatto String
  contatto     String
  budget       String?
  messaggio    String
  noteAdmin    String?
  creatoIl     DateTime       @default(now())
  aggiornatoIl DateTime       @updatedAt

  utente Utente?          @relation(fields: [utenteId], references: [id], onDelete: SetNull)
  storico StoricoStato[]
  messaggi Messaggio[]

  @@index([stato, creatoIl])
}

/// Messaggio della conversazione fra cliente e amministrazione su una richiesta.
model Messaggio {
  id          String   @id @default(cuid())
  richiestaId String
  /// Autore del messaggio: l'utente stesso o un amministratore.
  daAdmin     Boolean  @default(false)
  testo       String
  /// Vero quando il destinatario l'ha visto: alimenta il badge non lette.
  letto       Boolean  @default(false)
  /// Traccia i messaggi arrivati dal bot invece che dal sito.
  daTelegram  Boolean  @default(false)
  creatoIl    DateTime @default(now())

  richiesta Richiesta @relation(fields: [richiestaId], references: [id], onDelete: Cascade)

  @@index([richiestaId, creatoIl])
  @@index([letto, daAdmin])
}

/// Traccia ogni cambio di stato di una richiesta, per la cronologia utente.
model StoricoStato {
  id          String         @id @default(cuid())
  richiestaId String
  stato       StatoRichiesta
  nota        String?
  creatoIl    DateTime       @default(now())

  richiesta Richiesta @relation(fields: [richiestaId], references: [id], onDelete: Cascade)

  @@index([richiestaId, creatoIl])
}

model Notifica {
  id        String   @id @default(cuid())
  utenteId  String
  titolo    String
  testo     String
  letta     Boolean  @default(false)
  url       String?
  creatoIl  DateTime @default(now())

  utente Utente @relation(fields: [utenteId], references: [id], onDelete: Cascade)

  @@index([utenteId, letta])
}

/// Token monouso per collegare una sessione browser a un account Telegram.
/// Il browser genera il token, l'utente apre il bot con /start <token>,
/// il webhook lo marca come confermato e il browser completa l'accesso.
model TokenCollegamento {
  id         String    @id @default(cuid())
  token      String    @unique
  utenteId   String?
  confermato Boolean   @default(false)
  usato      Boolean   @default(false)
  scadeIl    DateTime
  creatoIl   DateTime  @default(now())

  utente Utente? @relation(fields: [utenteId], references: [id], onDelete: Cascade)

  @@index([token, usato])
}

/// Testi della homepage modificabili da admin, indicizzati per chiave.
model ContenutoSito {
  chiave       String   @id
  valore       String
  gruppo       String   @default("generale")
  aggiornatoIl DateTime @updatedAt
}

model Servizio {
  id           String   @id @default(cuid())
  titolo       String
  descrizione  String
  icona        String   @default("code")
  attivo       Boolean  @default(true)
  ordine       Int      @default(0)
  aggiornatoIl DateTime @updatedAt

  @@index([attivo, ordine])
}

/// Funzione di automazione proposta in "Automatizzati con noi". Le prime
/// (selezionabile = true) sono scelte dal cliente nel modulo di richiesta;
/// quella sulla sicurezza dei dati è inclusa ovunque e non si sceglie.
model Automazione {
  id            String   @id @default(cuid())
  slug          String   @unique
  titolo        String
  descrizione   String
  icona         String   @default("bolt")
  selezionabile Boolean  @default(true)
  attivo        Boolean  @default(true)
  ordine        Int      @default(0)
  aggiornatoIl  DateTime @updatedAt

  @@index([attivo, ordine])
}

model Vantaggio {
  id           String   @id @default(cuid())
  titolo       String
  descrizione  String
  icona        String   @default("spark")
  attivo       Boolean  @default(true)
  ordine       Int      @default(0)
  aggiornatoIl DateTime @updatedAt

  @@index([attivo, ordine])
}

model Faq {
  id           String   @id @default(cuid())
  domanda      String
  risposta     String
  attiva       Boolean  @default(true)
  ordine       Int      @default(0)
  aggiornatoIl DateTime @updatedAt

  @@index([attiva, ordine])
}

model Contatto {
  id           String   @id @default(cuid())
  etichetta    String
  valore       String
  url          String?
  icona        String   @default("link")
  attivo       Boolean  @default(true)
  ordine       Int      @default(0)
  aggiornatoIl DateTime @updatedAt

  @@index([attivo, ordine])
}
