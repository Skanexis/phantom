# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# database locale e client Prisma generato
*.db
*.db-journal
/prisma/*.db
/src/generated/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# schermate generate: contengono dati reali di sessione
/schermate/

# video generati: pesanti e ricreabili con npm run video
/video/
